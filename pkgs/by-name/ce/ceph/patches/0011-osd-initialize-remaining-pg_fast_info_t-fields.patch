From fc68f11faaf5bb82bd9efbc607dda6376f6627c4 Mon Sep 17 00:00:00 2001
From: Patrick Chilton <chpatrick@gmail.com>
Date: Fri, 30 Oct 2026 18:17:34 +0100
Subject: [PATCH] osd: initialize remaining pg_fast_info_t fields

A default-constructed pg_fast_info_t, like the generate_test_instances()
one, leaves last_user_version and the scalar stats uninitialized. This
makes check-generated.sh fail nondeterministically when dumping it.

Signed-off-by: Patrick Chilton <chpatrick@gmail.com>
Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015iJNaVvTHvLN83P1TKdUHL
---
 src/osd/osd_types.h | 22 +++++++++++-----------
 1 file changed, 11 insertions(+), 11 deletions(-)

diff --git a/src/osd/osd_types.h b/src/osd/osd_types.h
index aa40c5afb57..b4aab9ef832 100644
--- a/src/osd/osd_types.h
+++ b/src/osd/osd_types.h
@@ -3201,12 +3201,12 @@ std::ostream& operator<<(std::ostream& out, const pg_info_t& pgi);
 struct pg_fast_info_t {
   eversion_t last_update;
   eversion_t last_complete;
-  version_t last_user_version;
+  version_t last_user_version = 0;
   std::map<shard_id_t,std::pair<eversion_t,eversion_t>> partial_writes_last_complete;
   epoch_t partial_writes_last_complete_epoch = 0;
   struct { // pg_stat_t stats
     eversion_t version;
-    version_t reported_seq;
+    version_t reported_seq = 0;
     utime_t last_fresh;
     utime_t last_active;
     utime_t last_peered;
@@ -3214,17 +3214,17 @@ struct pg_fast_info_t {
     utime_t last_unstale;
     utime_t last_undegraded;
     utime_t last_fullsized;
-    int64_t log_size;  // (also ondisk_log_size, which has the same value)
+    int64_t log_size = 0;  // (also ondisk_log_size, which has the same value)
     struct { // object_stat_collection_t stats;
       struct { // objct_stat_sum_t sum
-	int64_t num_bytes;    // in bytes
-	int64_t num_objects;
-	int64_t num_object_copies;
-	int64_t num_rd;
-	int64_t num_rd_kb;
-	int64_t num_wr;
-	int64_t num_wr_kb;
-	int64_t num_objects_dirty;
+	int64_t num_bytes = 0;    // in bytes
+	int64_t num_objects = 0;
+	int64_t num_object_copies = 0;
+	int64_t num_rd = 0;
+	int64_t num_rd_kb = 0;
+	int64_t num_wr = 0;
+	int64_t num_wr_kb = 0;
+	int64_t num_objects_dirty = 0;
       } sum;
     } stats;
   } stats;
