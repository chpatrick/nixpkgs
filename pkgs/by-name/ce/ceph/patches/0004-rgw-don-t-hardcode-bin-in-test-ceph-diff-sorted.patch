From 80e06671fd05f787ce819d1a427a31b85ba66090 Mon Sep 17 00:00:00 2001
From: Patrick Chilton <chpatrick@gmail.com>
Date: Wed, 17 Jun 2026 15:07:12 +0200
Subject: [PATCH] rgw: don't hardcode /bin/ in test-ceph-diff-sorted

These paths don't exist eg. on NixOS.

Signed-off-by: Patrick Chilton <chpatrick@gmail.com>
---
 src/test/rgw/test-ceph-diff-sorted.sh | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/test/rgw/test-ceph-diff-sorted.sh b/src/test/rgw/test-ceph-diff-sorted.sh
index c164e5547f4..4d0d7184733 100755
--- a/src/test/rgw/test-ceph-diff-sorted.sh
+++ b/src/test/rgw/test-ceph-diff-sorted.sh
@@ -61,14 +61,14 @@ ceph-diff-sorted $long $long >"${out1}"
 $assert $? -eq 0
 $assert $(cat $out1 | wc -l) -eq 0
 
-# test non-match; use /bin/diff to verify
-/bin/diff $short $long >"${out2}"
+# test non-match; use diff to verify
+diff $short $long >"${out2}"
 ceph-diff-sorted $short $long >"${out1}"
 $assert $? -eq 1
 $assert $(cat $out1 | grep '^<' | wc -l) -eq $(cat $out2 | grep '^<' | wc -l)
 $assert $(cat $out1 | grep '^>' | wc -l) -eq $(cat $out2 | grep '^>' | wc -l)
 
-/bin/diff $long $short >"${out2}"
+diff $long $short >"${out2}"
 ceph-diff-sorted $long $short >"${out1}"
 $assert $? -eq 1
 $assert $(cat $out1 | grep '^<' | wc -l) -eq $(cat $out2 | grep '^<' | wc -l)
@@ -105,4 +105,4 @@ $assert $? -eq 3
 
 #### clean-up ####
 
-/bin/rm -f $short $short_w_blank $long $unsorted $empty $out1 $out2
+rm -f $short $short_w_blank $long $unsorted $empty $out1 $out2
